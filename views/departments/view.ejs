<!DOCTYPE html>
<html lang="en" class="pg-departments-view">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= title %></title>

    <link rel="stylesheet" href="/main.css">
</head>

<body>

<%- include('../partials/topnav') %>


<div class="container">

    <h1>Department Details</h1>

    <div class="field">
        <label>Department ID</label>
        <div><%= department.department_id %></div>
    </div>

    <div class="field">
        <label>Department Name</label>
        <div><%= department.department_name %></div>
    </div>

    <div class="field">
        <label>Location</label>
        <div><%= department.location || "-" %></div>
    </div>

    <div class="buttons">
        <% if (can.edit) { %>
<a href="/departments/edit/<%= department.department_id %>" class="btn btn-edit">Edit</a>
<% } %>
        <a href="/departments" class="btn btn-back">Back to List</a>
    </div>

</div>

<%- include('../partials/footer') %>

</body>
</html>
