<!DOCTYPE html>
<html lang="en" class="pg-departments-index">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= title %></title>

    <link rel="stylesheet" href="/main.css">
</head>

<body>

<%- include('../partials/topnav') %>


<div class="container">

    <div class="top-bar">
        <h1>Departments</h1>
        <% if (can.add) { %>
<a href="/departments/add" class="btn btn-add">+ Add Department</a>
<% } %>
    </div>

    <%- include('../partials/toolbar') %>



    <% if (departments.length === 0) { %>

        <div class="empty">No departments found.</div>

    <% } else { %>

        <table>
            <thead>
                <tr>
                    <th>ID</th>
                    <th>Department Name</th>
                    <th>Location</th>
                    <th>Actions</th>
                </tr>
            </thead>
            <tbody>

                <% departments.forEach(department => { %>

                    <tr>
                        <td><%= department.department_id %></td>
                        <td><%= department.department_name %></td>
                        <td><%= department.location || "-" %></td>
                        <td class="actions">

                            <a href="/departments/view/<%= department.department_id %>" class="btn btn-view">View</a>
                            <% if (can.edit) { %>
<a href="/departments/edit/<%= department.department_id %>" class="btn btn-edit">Edit</a>
<% } %>

                            <% if (can.delete) { %>
<form
                                class="inline"
                                action="/departments/delete/<%= department.department_id %>"
                                method="POST"
                                onsubmit="return confirm('Delete this department?');">
                                <button type="submit" class="btn btn-delete">Delete</button>
                            </form>
<% } %>

                        </td>
                    </tr>

                <% }); %>

            </tbody>
        </table>

    <% } %>

</div>

<%- include('../partials/footer') %>

</body>
</html>
