<%# Shared by add.ejs and edit.ejs.
    locals: values, departments, docTypes, docNumberLocked, metaLocked %>

<div class="form-row">

    <div class="form-group">
        <label for="doc_number">Document Number</label>
        <input
            type="text"
            id="doc_number"
            name="doc_number"
            value="<%= values.doc_number || '' %>"
            placeholder="e.g. HSE-POL-001"
            maxlength="50"
            <%= docNumberLocked ? 'readonly' : 'required' %>>
    </div>

    <div class="form-group">
        <label for="doc_type">Document Type</label>
        <select id="doc_type" name="doc_type" <%= metaLocked ? 'disabled' : 'required' %>>
            <option value="">-- Select Type --</option>
            <% docTypes.forEach(t => { %>
                <option value="<%= t %>" <%= values.doc_type === t ? 'selected' : '' %>><%= t %></option>
            <% }); %>
        </select>
    </div>

</div>

<div class="form-row">

    <div class="form-group">
        <label for="title">Title</label>
        <input
            type="text"
            id="title"
            name="title"
            value="<%= values.title || '' %>"
            maxlength="200"
            <%= metaLocked ? 'readonly' : 'required' %>>
    </div>

    <div class="form-group">
        <label for="department_id">Department</label>
        <select id="department_id" name="department_id" <%= metaLocked ? 'disabled' : '' %>>
            <option value="">-- All / None --</option>
            <% departments.forEach(dep => { %>
                <option
                    value="<%= dep.department_id %>"
                    <%= Number(values.department_id) === dep.department_id ? 'selected' : '' %>>
                    <%= dep.department_name %>
                </option>
            <% }); %>
        </select>
    </div>

</div>

<% if (metaLocked) { %>
    <p class="hint" style="margin-top:-8px; margin-bottom:18px;">
        Title, type and department are fixed once the document has been published.
    </p>
<% } %>

<div class="form-group">
    <label for="change_summary">Summary of Changes</label>
    <input
        type="text"
        id="change_summary"
        name="change_summary"
        value="<%= values.change_summary || '' %>"
        maxlength="500"
        placeholder="What is new or different in this version?">
</div>

<div class="form-group">
    <label for="content">Content</label>
    <textarea id="content" name="content" class="content" required><%= values.content || '' %></textarea>
    <div class="hint">Plain text. Line breaks and blank lines are kept when the document is displayed.</div>
</div>
