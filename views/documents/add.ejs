<!DOCTYPE html>
<html lang="en" class="pg-documents">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= title %></title>
    <link rel="stylesheet" href="/main.css">
</head>

<body>

<%- include('../partials/topnav') %>


<div class="container narrow">

    <h1>New Document</h1>
    <div class="subtitle">Saved as version 1 (Draft). Submit it for review when it is ready.</div>

    <% if (error) { %>
        <div class="error"><%= error %></div>
    <% } %>

    <form action="/documents/add" method="POST">

        <%- include('_fields', {
            values: values,
            departments: departments,
            docTypes: docTypes,
            docNumberLocked: false,
            metaLocked: false
        }) %>

        <div class="buttons">
            <button type="submit" class="btn btn-approve">Save Draft</button>
            <a href="/documents" class="btn btn-back">Cancel</a>
        </div>

    </form>

</div>

<%- include('../partials/footer') %>

</body>
</html>
