<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Log in &mdash; SafetyPro</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Archivo+Expanded:wght@600;700;800&family=Inter:wght@400;500;600;700&family=IBM+Plex+Mono:wght@500&display=swap" rel="stylesheet">
<style>
  :root {
    --charcoal: #14181C;
    --panel: #1B2126;
    --panel-raised: #232B31;
    --hazard: #F2B705;
    --rust: #C6512F;
    --steel-line: #333D45;
    --ink: #E9EDEF;
    --ink-muted: #8B96A1;
  }
  * { box-sizing: border-box; }
  body {
    margin: 0;
    min-height: 100vh;
    background: var(--charcoal);
    color: var(--ink);
    font-family: 'Inter', -apple-system, sans-serif;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 24px;
  }
  .card {
    width: 100%;
    max-width: 380px;
    background: var(--panel);
    border: 1px solid var(--steel-line);
    border-radius: 6px;
    padding: 34px 32px 30px;
  }
  .brand {
    display: flex;
    align-items: center;
    gap: 10px;
    font-family: 'Archivo Expanded', sans-serif;
    font-weight: 700;
    font-size: 19px;
    margin-bottom: 28px;
  }
  .brand-mark {
    width: 28px;
    height: 28px;
    background: var(--hazard);
    clip-path: polygon(50% 0%, 100% 50%, 50% 100%, 0% 50%);
    display: inline-flex;
    align-items: center;
    justify-content: center;
    color: var(--charcoal);
    font-family: 'IBM Plex Mono', monospace;
    font-weight: 700;
    font-size: 12px;
  }
  h1 {
    font-family: 'Archivo Expanded', sans-serif;
    font-size: 22px;
    margin: 0 0 6px;
  }
  .sub {
    font-size: 14px;
    color: var(--ink-muted);
    margin: 0 0 26px;
  }
  .field { margin-bottom: 16px; }
  label {
    display: block;
    font-size: 13px;
    color: var(--ink-muted);
    margin-bottom: 6px;
  }
  input[type="email"], input[type="password"], input[type="text"] {
    width: 100%;
    background: var(--panel-raised);
    border: 1px solid var(--steel-line);
    border-radius: 4px;
    color: var(--ink);
    font-size: 14.5px;
    padding: 11px 12px;
    font-family: 'Inter', sans-serif;
  }
  input:focus {
    outline: none;
    border-color: var(--hazard);
  }
  .error {
    background: rgba(198, 81, 47, 0.14);
    border: 1px solid rgba(198, 81, 47, 0.4);
    color: #E38562;
    font-size: 13.5px;
    padding: 10px 12px;
    border-radius: 4px;
    margin-bottom: 18px;
  }
  .btn-primary {
    width: 100%;
    padding: 12px;
    background: var(--hazard);
    color: #1A1503;
    border: none;
    border-radius: 4px;
    font-weight: 600;
    font-size: 14.5px;
    cursor: pointer;
    font-family: 'Inter', sans-serif;
  }
  .btn-primary:hover { background: #ffcb1f; }
  .foot {
    text-align: center;
    font-size: 13px;
    color: var(--ink-muted);
    margin-top: 20px;
  }
  a { color: var(--hazard); text-decoration: none; }
  a:hover { text-decoration: underline; }
</style>
</head>
<body>
  <div class="card">
    <div class="brand">
      <span class="brand-mark">SP</span>
      SafetyPro
    </div>
    <h1>Log in</h1>
    <p class="sub">Access your site's HSSEQ records.</p>

    <% if (typeof error !== 'undefined' && error) { %>
      <div class="error"><%= error %></div>
    <% } %>

    <form method="POST" action="/login">
      <div class="field">
        <label for="email">Email</label>
        <input type="email" id="email" name="email" required autofocus>
      </div>
      <div class="field">
        <label for="password">Password</label>
        <input type="password" id="password" name="password" required>
      </div>
      <button type="submit" class="btn-primary">Log in</button>
    </form>

    <p class="foot">Trouble signing in? Contact your site administrator.</p>
  </div>
</body>
</html>
