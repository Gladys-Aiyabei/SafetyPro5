
<!DOCTYPE html>
<html lang="en" class="pg-audits-index">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title><%= title %></title>

    <link rel="stylesheet" href="/main.css">
</head>

<body>

<%- include('../partials/topnav') %>


<div class="container">

    <div class="top-bar">
        <h1>Audits</h1>

        <% if (can.add) { %>
<a href="/audits/add" class="btn btn-add">
            + Add Audit
        </a>
<% } %>
    </div>

    <%- include('../partials/toolbar') %>



    <% if (audits.length === 0) { %>

        <p>No audits found.</p>

    <% } else { %>

        <table>

            <thead>
                <tr>
                    <th>ID</th>
                    <th>Date</th>
                    <th>Audit Type</th>
                    <th>Department</th>
                    <th>Auditor</th>
                    <th>Score</th>
                    <th>Status</th>
                    <th>Actions</th>
                </tr>
            </thead>

            <tbody>

                <% audits.forEach(audit => { %>

                    <tr>

                        <td>
                            <%= audit.audit_id %>
                        </td>

                        <td>
                            <%= audit.audit_date ? audit.audit_date.toISOString().split('T')[0] : '' %>
                        </td>

                        <td>
                            <%= audit.audit_type %>
                        </td>

                        <td>
                            <%= audit.department_id %>
                        </td>

                        <td>
                            <%= audit.auditor %>
                        </td>

                        <td>
                            <%= audit.score %>
                        </td>

                        <td class="status">
                            <%= audit.status %>
                        </td>

                        <td>

                            <div class="actions">

                                <a
                                    href="/audits/view/<%= audit.audit_id %>"
                                    class="btn btn-view">
                                    View
                                </a>

                                <% if (can.edit) { %>
<a
                                    href="/audits/edit/<%= audit.audit_id %>"
                                    class="btn btn-edit">
                                    Edit
                                </a>
<% } %>

                                <% if (can.delete) { %>
<form
                                    action="/audits/delete/<%= audit.audit_id %>"
                                    method="POST"
                                    onsubmit="return confirm('Are you sure you want to delete this audit?');">

                                    <button
                                        type="submit"
                                        class="btn btn-delete">
                                        Delete
                                    </button>

                                </form>
<% } %>

                            </div>

                        </td>

                    </tr>

                <% }); %>

            </tbody>

        </table>

    <% } %>

</div>

<%- include('../partials/footer') %>

</body>
</html>
