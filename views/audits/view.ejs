
<!DOCTYPE html>
<html lang="en" class="pg-audits-view">

<head>

    <meta charset="UTF-8">

    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title><%= title %></title>


    <link rel="stylesheet" href="/main.css">
</head>

<body>

<%- include('../partials/topnav') %>


<div class="container">

    <h1>Audit Details</h1>


    <div class="detail">

        <div class="label">
            Audit ID
        </div>

        <div class="value">
            <%= audit.audit_id %>
        </div>

    </div>


    <div class="detail">

        <div class="label">
            Audit Date
        </div>

        <div class="value">

            <%= audit.audit_date
                ? audit.audit_date.toISOString().split('T')[0]
                : '' %>

        </div>

    </div>


    <div class="detail">

        <div class="label">
            Audit Type
        </div>

        <div class="value">
            <%= audit.audit_type %>
        </div>

    </div>


    <div class="detail">

        <div class="label">
            Department
        </div>

        <div class="value">
            <%= audit.department_name || audit.department_id %>
        </div>

    </div>


    <div class="detail">

        <div class="label">
            Auditor
        </div>

        <div class="value">
            <%= audit.auditor %>
        </div>

    </div>


    <div class="detail">

        <div class="label">
            Findings
        </div>

        <div class="value findings">
            <%= audit.findings || 'No findings recorded' %>
        </div>

    </div>


    <div class="detail">

        <div class="label">
            Score
        </div>

        <div class="value">
            <%= audit.score !== null ? audit.score : 'Not scored' %>
        </div>

    </div>


    <div class="detail">

        <div class="label">
            Status
        </div>

        <div class="value">
            <%= audit.status %>
        </div>

    </div>


    <a
        href="/audits"
        class="btn btn-back">
        ← Back to Audits
    </a>


    <% if (can.edit) { %>
<a
        href="/audits/edit/<%= audit.audit_id %>"
        class="btn btn-edit">
        Edit Audit
    </a>
<% } %>

</div>

<%- include('../partials/footer') %>

</body>

</html>
