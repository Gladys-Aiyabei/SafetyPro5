<!DOCTYPE html>
<html lang="en" class="pg-audits-add">

<head>

    <meta charset="UTF-8">

    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title><%= title %></title>


    <link rel="stylesheet" href="/main.css">
</head>

<body>

<%- include('../partials/topnav') %>


<div class="container">

    <h1>Add New Audit</h1>

    <form action="/audits/add" method="POST">

        <!-- Audit Date -->
        <div class="form-group">

            <label for="audit_date">
                Audit Date
            </label>

            <input
                type="date"
                id="audit_date"
                name="audit_date"
                required>

        </div>


        <!-- Audit Type -->
        <div class="form-group">

            <label for="audit_type">
                Audit Type
            </label>

            <input
                type="text"
                id="audit_type"
                name="audit_type"
                placeholder="e.g. Safety Audit"
                required>

        </div>


        <!-- Department -->
        <div class="form-group">

            <label for="department_id">
                Department
            </label>

            <select
                id="department_id"
                name="department_id"
                required>

                <option value="">
                    -- Select Department --
                </option>

                <% departments.forEach(department => { %>

                    <option value="<%= department.department_id %>">

                        <%= department.department_name %>

                        <% if (department.location) { %>
                            - <%= department.location %>
                        <% } %>

                    </option>

                <% }); %>

            </select>

        </div>


        <!-- Auditor -->
        <div class="form-group">

            <label for="auditor">
                Auditor
            </label>

            <input
                type="text"
                id="auditor"
                name="auditor"
                placeholder="Enter auditor name"
                required>

        </div>


        <!-- Findings -->
        <div class="form-group">

            <label for="findings">
                Findings
            </label>

            <textarea
                id="findings"
                name="findings"
                placeholder="Enter audit findings"></textarea>

        </div>


        <!-- Score -->
        <div class="form-group">

            <label for="score">
                Score
            </label>

            <input
                type="number"
                id="score"
                name="score"
                min="0"
                max="100"
                step="0.01"
                placeholder="e.g. 85.50">

        </div>


        <!-- Status -->
        <div class="form-group">

            <label for="status">
                Status
            </label>

            <select
                id="status"
                name="status"
                required>

                <option value="">
                    -- Select Status --
                </option>

                <option value="Planned">
                    Planned
                </option>

                <option value="In Progress">
                    In Progress
                </option>

                <option value="Completed">
                    Completed
                </option>

                <option value="Closed">
                    Closed
                </option>

            </select>

        </div>


        <!-- Buttons -->
        <div class="buttons">

            <button
                type="submit"
                class="btn btn-save">
                Save Audit
            </button>

            <a
                href="/audits"
                class="btn btn-cancel">
                Cancel
            </a>

        </div>

    </form>

</div>

<%- include('../partials/footer') %>

</body>

</html>