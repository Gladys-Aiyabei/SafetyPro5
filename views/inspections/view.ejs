<!DOCTYPE html>

<html lang="en" class="pg-inspections-view">

<head>

```
<meta charset="UTF-8">

<meta name="viewport"
      content="width=device-width, initial-scale=1.0">

<title><%= title %></title>

```

    <link rel="stylesheet" href="/main.css">
</head>

<body>

<%- include('../partials/topnav') %>


<div class="container">

```
<h1>Inspection Details</h1>

<div class="details">

    <div class="label">
        Inspection ID
    </div>

    <div class="value">
        <%= inspection.inspection_id %>
    </div>


    <div class="label">
        Inspection Date
    </div>

    <div class="value">

        <%= inspection.inspection_date
            ? new Date(inspection.inspection_date).toISOString().split('T')[0]
            : '-' %>

    </div>


    <div class="label">
        Inspection Type
    </div>

    <div class="value">
        <%= inspection.inspection_type || '-' %>
    </div>


    <div class="label">
        Location
    </div>

    <div class="value">
        <%= inspection.location || '-' %>
    </div>


    <div class="label">
        Inspector
    </div>

    <div class="value">
        <%= inspection.inspector_name || 'Not assigned' %>
    </div>


    <div class="label">
        Overall Score
    </div>

    <div class="value">
        <%= inspection.overall_score ?? '-' %>
    </div>


    <div class="label">
        Status
    </div>

    <div class="value">
        <%= inspection.status || '-' %>
    </div>


    <div class="label">
        Findings
    </div>

    <div class="value findings">
        <%= inspection.findings || 'No findings recorded.' %>
    </div>

</div>


<div class="buttons">

    <a href="/inspections" class="btn back">
        Back
    </a>

    <% if (can.edit) { %>
<a
        href="/inspections/edit/<%= inspection.inspection_id %>"
        class="btn edit">
        Edit
    </a>
<% } %>


    <% if (can.delete) { %>
<form
        action="/inspections/delete/<%= inspection.inspection_id %>"
        method="POST"
        style="display:inline;"
        onsubmit="return confirm('Are you sure you want to delete this inspection?');">

        <button
            type="submit"
            class="btn delete">
            Delete
        </button>

    </form>
<% } %>

</div>
```

</div>

<%- include('../partials/footer') %>

</body>

</html>
