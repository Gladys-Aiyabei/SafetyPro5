<!DOCTYPE html>

<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

```
<title><%= title %></title>

<style>
    body {
        font-family: Arial, sans-serif;
        margin: 0;
        background: #f4f6f8;
    }

    .container {
        width: 95%;
        margin: 30px auto;
    }

    .header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 20px;
    }

    h1 {
        color: #333;
    }

    .btn {
        padding: 9px 14px;
        text-decoration: none;
        border-radius: 5px;
        color: white;
        border: none;
        cursor: pointer;
        display: inline-block;
        font-size: 14px;
    }

    .btn-add {
        background: #198754;
    }

    .btn-view {
        background: #0d6efd;
    }

    .btn-edit {
        background: #ffc107;
        color: #000;
    }

    .btn-delete {
        background: #dc3545;
    }

    table {
        width: 100%;
        border-collapse: collapse;
        background: white;
        box-shadow: 0 2px 8px rgba(0,0,0,0.1);
    }

    th {
        background: #212529;
        color: white;
        padding: 12px;
        text-align: left;
    }

    td {
        padding: 10px;
        border-bottom: 1px solid #ddd;
    }

    tr:hover {
        background: #f1f1f1;
    }

    .actions {
        display: flex;
        gap: 5px;
    }

    .status {
        padding: 5px 9px;
        border-radius: 15px;
        font-size: 12px;
        font-weight: bold;
    }

    .status-completed {
        background: #d1e7dd;
        color: #0f5132;
    }

    .status-pending {
        background: #fff3cd;
        color: #664d03;
    }

    .status-failed {
        background: #f8d7da;
        color: #842029;
    }
</style>
```

</head>

<body>

<div class="container">

```
<div class="header">
    <h1>Inspections</h1>

    <a href="/inspections/add" class="btn btn-add">
        + Add Inspection
    </a>
</div>

<% if (inspections.length === 0) { %>

    <p>No inspections found.</p>

<% } else { %>

    <table>

        <thead>
            <tr>
                <th>ID</th>
                <th>Date</th>
                <th>Inspection Type</th>
                <th>Location</th>
                <th>Inspector</th>
                <th>Score</th>
                <th>Status</th>
                <th>Actions</th>
            </tr>
        </thead>

        <tbody>

            <% inspections.forEach(function(inspection) { %>

                <tr>

                    <td>
                        <%= inspection.inspection_id %>
                    </td>

                    <td>
                        <%= inspection.inspection_date
                            ? new Date(inspection.inspection_date).toISOString().split('T')[0]
                            : '' %>
                    </td>

                    <td>
                        <%= inspection.inspection_type || '-' %>
                    </td>

                    <td>
                        <%= inspection.location || '-' %>
                    </td>

                    <td>
                        <%= inspection.inspector_name || 'Not assigned' %>
                    </td>

                    <td>
                        <%= inspection.overall_score ?? '-' %>
                    </td>

                    <td>

                        <% if (inspection.status === 'Completed') { %>

                            <span class="status status-completed">
                                Completed
                            </span>

                        <% } else if (inspection.status === 'Pending') { %>

                            <span class="status status-pending">
                                Pending
                            </span>

                        <% } else if (inspection.status === 'Failed') { %>

                            <span class="status status-failed">
                                Failed
                            </span>

                        <% } else { %>

                            <%= inspection.status || '-' %>

                        <% } %>

                    </td>

                    <td>

                        <div class="actions">

                            <a
                                href="/inspections/view/<%= inspection.inspection_id %>"
                                class="btn btn-view">
                                View
                            </a>

                            <a
                                href="/inspections/edit/<%= inspection.inspection_id %>"
                                class="btn btn-edit">
                                Edit
                            </a>

                            <form
                                action="/inspections/delete/<%= inspection.inspection_id %>"
                                method="POST"
                                style="display:inline;"
                                onsubmit="return confirm('Are you sure you want to delete this inspection?');">

                                <button
                                    type="submit"
                                    class="btn btn-delete">
                                    Delete
                                </button>

                            </form>

                        </div>

                    </td>

                </tr>

            <% }); %>

        </tbody>

    </table>

<% } %>
```

</div>

</body>
</html>
