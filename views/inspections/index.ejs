<!DOCTYPE html>

<html lang="en" class="pg-inspections-index">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

```
<title><%= title %></title>

```

    <link rel="stylesheet" href="/main.css">
</head>

<body>

<%- include('../partials/topnav') %>


<div class="container">

```
<div class="header">
    <h1>Inspections</h1>

    <% if (can.add) { %>
<a href="/inspections/add" class="btn btn-add">
        + Add Inspection
    </a>
<% } %>
</div>

    <%- include('../partials/toolbar') %>



<% if (inspections.length === 0) { %>

    <p>No inspections found.</p>

<% } else { %>

    <table>

        <thead>
            <tr>
                <th>ID</th>
                <th>Date</th>
                <th>Inspection Type</th>
                <th>Location</th>
                <th>Inspector</th>
                <th>Score</th>
                <th>Status</th>
                <th>Actions</th>
            </tr>
        </thead>

        <tbody>

            <% inspections.forEach(function(inspection) { %>

                <tr>

                    <td>
                        <%= inspection.inspection_id %>
                    </td>

                    <td>
                        <%= inspection.inspection_date
                            ? new Date(inspection.inspection_date).toISOString().split('T')[0]
                            : '' %>
                    </td>

                    <td>
                        <%= inspection.inspection_type || '-' %>
                    </td>

                    <td>
                        <%= inspection.location || '-' %>
                    </td>

                    <td>
                        <%= inspection.inspector_name || 'Not assigned' %>
                    </td>

                    <td>
                        <%= inspection.overall_score ?? '-' %>
                    </td>

                    <td>

                        <% if (inspection.status === 'Completed') { %>

                            <span class="status status-completed">
                                Completed
                            </span>

                        <% } else if (inspection.status === 'Pending') { %>

                            <span class="status status-pending">
                                Pending
                            </span>

                        <% } else if (inspection.status === 'Failed') { %>

                            <span class="status status-failed">
                                Failed
                            </span>

                        <% } else { %>

                            <%= inspection.status || '-' %>

                        <% } %>

                    </td>

                    <td>

                        <div class="actions">

                            <a
                                href="/inspections/view/<%= inspection.inspection_id %>"
                                class="btn btn-view">
                                View
                            </a>

                            <% if (can.edit) { %>
<a
                                href="/inspections/edit/<%= inspection.inspection_id %>"
                                class="btn btn-edit">
                                Edit
                            </a>
<% } %>

                            <% if (can.delete) { %>
<form
                                action="/inspections/delete/<%= inspection.inspection_id %>"
                                method="POST"
                                style="display:inline;"
                                onsubmit="return confirm('Are you sure you want to delete this inspection?');">

                                <button
                                    type="submit"
                                    class="btn btn-delete">
                                    Delete
                                </button>

                            </form>
<% } %>

                        </div>

                    </td>

                </tr>

            <% }); %>

        </tbody>

    </table>

<% } %>
```

</div>

<%- include('../partials/footer') %>

</body>
</html>
