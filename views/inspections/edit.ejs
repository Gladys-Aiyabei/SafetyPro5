<!DOCTYPE html>

<html lang="en" class="pg-inspections-edit">

<head>

```
<meta charset="UTF-8">

<meta name="viewport"
      content="width=device-width, initial-scale=1.0">

<title><%= title %></title>

```

    <link rel="stylesheet" href="/main.css">
</head>

<body>

<%- include('../partials/topnav') %>


<div class="container">

```
<h1>Edit Inspection</h1>

<form
    action="/inspections/edit/<%= inspection.inspection_id %>"
    method="POST">


    <div class="form-group">

        <label for="inspection_date">
            Inspection Date *
        </label>

        <input
            type="date"
            id="inspection_date"
            name="inspection_date"
            value="<%= inspection.inspection_date
                ? new Date(inspection.inspection_date).toISOString().split('T')[0]
                : '' %>"
            required>

    </div>


    <div class="form-group">

        <label for="inspection_type">
            Inspection Type
        </label>

        <input
            type="text"
            id="inspection_type"
            name="inspection_type"
            value="<%= inspection.inspection_type || '' %>">

    </div>


    <div class="form-group">

        <label for="location">
            Location
        </label>

        <input
            type="text"
            id="location"
            name="location"
            value="<%= inspection.location || '' %>">

    </div>


    <div class="form-group">

        <label for="inspector_id">
            Inspector
        </label>

        <select
            id="inspector_id"
            name="inspector_id">

            <option value="">
                -- Select Inspector --
            </option>


            <% employees.forEach(function(employee) { %>

                <option
                    value="<%= employee.employee_id %>"
                    <%= inspection.inspector_id == employee.employee_id
                        ? 'selected'
                        : '' %>>

                    <%= employee.employee_name %>

                </option>

            <% }); %>

        </select>

    </div>


    <div class="form-group">

        <label for="findings">
            Findings
        </label>

        <textarea
            id="findings"
            name="findings"><%= inspection.findings || '' %></textarea>

    </div>


    <div class="form-group">

        <label for="overall_score">
            Overall Score
        </label>

        <input
            type="number"
            id="overall_score"
            name="overall_score"
            min="0"
            max="100"
            step="0.01"
            value="<%= inspection.overall_score ?? '' %>">

    </div>


    <div class="form-group">

        <label for="status">
            Status
        </label>

        <select
            id="status"
            name="status">

            <option value="">
                -- Select Status --
            </option>

            <option
                value="Pending"
                <%= inspection.status === 'Pending'
                    ? 'selected'
                    : '' %>>
                Pending
            </option>

            <option
                value="Completed"
                <%= inspection.status === 'Completed'
                    ? 'selected'
                    : '' %>>
                Completed
            </option>

            <option
                value="Failed"
                <%= inspection.status === 'Failed'
                    ? 'selected'
                    : '' %>>
                Failed
            </option>

        </select>

    </div>


    <div class="buttons">

        <button type="submit">
            Update Inspection
        </button>

        <a href="/inspections" class="cancel">
            Cancel
        </a>

    </div>

</form>
```

</div>

<%- include('../partials/footer') %>

</body>

</html>
