<!DOCTYPE html>
<html lang="en" class="pg-dashboard">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= title %></title>
    <link rel="stylesheet" href="/main.css">
    <script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.7/dist/chart.umd.min.js"></script>
    <script src="/charts.js"></script>
</head>

<body>

<%- include('partials/topnav') %>

<%
    const keep = ['module', 'from', 'to', 'year', 'month', 'user', 'department', 'activity', 'location'];
    const qs = keep.filter(k => f[k]).map(k => k + '=' + encodeURIComponent(f[k])).join('&');
    const sheetUrl = key => '/dashboard?sheet=' + key + (qs ? '&' + qs : '');

    const showModule = ['overview', 'findings', 'actions'].includes(sheet);
    const showStatus = ['findings', 'actions', 'employees'].includes(sheet);
    const statusOptions = sheet === 'findings' ? ['Open', 'Closed']
        : sheet === 'actions' ? ['Open', 'In Progress', 'Pending Approval', 'Closed']
        : ['Active', 'Inactive'];

    const moduleLink = { incidents: '/incidents', audits: '/audits', inspections: '/inspections', risks: '/risk-assessments',
        drills: '/erp', training: '/training', employees: '/employees', ptw: '/permits', users: '/users' };
%>

<div class="page">

    <div class="page-head">
        <div>
            <h1>Dashboard</h1>
            <div class="hint">
                <%= sheet === 'users'
                    ? 'Add, edit and delete the accounts that can log in. Only an Admin can see this sheet.'
                    : sheet === 'kpis'
                    ? 'Each KPI is measured from the module records and compared with its target. Filters narrow the period, department, owner and location.'
                    : "Filter once and switch between sheets. Filters apply to each record's own date, department and owner." %>
            </div>
        </div>
        <div class="sheet-tools">
            <% if (moduleLink[sheet]) { %><a href="<%= moduleLink[sheet] %>" class="btn btn-view">Open module</a><% } %>
            <% if (sheet === 'training') { %><a href="/training/matrix" class="btn btn-add">Compliance detail</a><% } %>
        </div>
    </div>

    <div class="tabs">
        <% sheets.forEach(s => { %>
            <a href="<%= sheetUrl(s.key) %>" class="<%= s.key === sheet ? 'on' : '' %>"><%= s.label %></a>
        <% }); %>
    </div>

    <% if (sheet !== 'users') { %>
    <form method="GET" action="/dashboard" class="filters">
        <input type="hidden" name="sheet" value="<%= sheet %>">

        <% if (showModule) { %>
            <div class="f">
                <label>Module</label>
                <select name="module">
                    <option value="">All modules</option>
                    <% modules.forEach(m => { %><option value="<%= m.key %>" <%= f.module === m.key ? 'selected' : '' %>><%= m.label %></option><% }); %>
                </select>
            </div>
        <% } %>

        <div class="f"><label>From</label><input type="date" name="from" value="<%= f.from %>"></div>
        <div class="f"><label>To</label><input type="date" name="to" value="<%= f.to %>"></div>

        <div class="f">
            <label>Year</label>
            <select name="year">
                <option value="">Any</option>
                <% years.forEach(y => { %><option <%= Number(f.year) === Number(y) ? 'selected' : '' %>><%= y %></option><% }); %>
            </select>
        </div>

        <div class="f">
            <label>Month</label>
            <select name="month">
                <option value="">Any</option>
                <% monthNames.forEach((m, i) => { %><option value="<%= i + 1 %>" <%= Number(f.month) === i + 1 ? 'selected' : '' %>><%= m %></option><% }); %>
            </select>
        </div>

        <div class="f">
            <label>Department</label>
            <select name="department">
                <option value="">All</option>
                <% departments.forEach(d => { %><option value="<%= d.department_id %>" <%= Number(f.department) === d.department_id ? 'selected' : '' %>><%= d.department_name %></option><% }); %>
            </select>
        </div>

        <div class="f">
            <label>User / employee</label>
            <select name="user">
                <option value="">All</option>
                <% employees.forEach(e => { %><option value="<%= e.employee_id %>" <%= Number(f.user) === e.employee_id ? 'selected' : '' %>><%= e.employee_name %></option><% }); %>
            </select>
        </div>

        <div class="f">
            <label>Process / activity</label>
            <input type="text" name="activity" value="<%= f.activity %>" list="activity-list" placeholder="Any">
            <datalist id="activity-list"><% activities.forEach(a => { %><option value="<%= a %>"><% }); %></datalist>
        </div>

        <div class="f">
            <label>Location</label>
            <select name="location">
                <option value="">All</option>
                <% locations.forEach(l => { %><option <%= f.location === l ? 'selected' : '' %>><%= l %></option><% }); %>
            </select>
        </div>

        <% if (showStatus) { %>
            <div class="f">
                <label>Status</label>
                <select name="status">
                    <option value="">All</option>
                    <% statusOptions.forEach(s => { %><option <%= f.status === s ? 'selected' : '' %>><%= s %></option><% }); %>
                </select>
            </div>
        <% } %>

        <% if (sheet === 'findings' || sheet === 'actions') { %>
            <div class="f">
                <label>Root cause</label>
                <select name="category">
                    <option value="">All</option>
                    <% categories.forEach(c => { %><option <%= f.category === c ? 'selected' : '' %>><%= c %></option><% }); %>
                    <% if (sheet === 'actions') { %><option <%= f.category === 'Not linked' ? 'selected' : '' %>>Not linked</option><% } %>
                </select>
            </div>
        <% } %>

        <% if (sheet === 'actions') { %>
            <div class="f">
                <label>&nbsp;</label>
                <label class="radio"><input type="checkbox" name="mine" value="1" <%= f.mine ? 'checked' : '' %>> Only my actions</label>
            </div>
        <% } %>

        <button class="btn btn-primary">Apply</button>
        <a href="/dashboard?sheet=<%= sheet %>" class="btn btn-back">Reset</a>
    </form>
    <% } %>

    <% if (sheet === 'actions' && f.mine && !hasEmployee) { %>
        <div class="notice">Your user account is not linked to an employee record, so "my actions" will be empty.</div>
    <% } %>

    <% if (data.kpis && data.kpis.length) { %>
        <div class="kpis">
            <% data.kpis.forEach(k => { %>
                <div class="kpi <%= k.color %>"><b><%= k.value %></b><span><%= k.label %></span></div>
            <% }); %>
        </div>
    <% } %>

    <% if (sheet === 'users') { %>
        <%- include('partials/users_panel', { data, employees, flash }) %>
    <% } %>

    <% if (data.charts && data.charts.length) { %>
        <div class="chart-grid">
            <% data.charts.forEach((c, i) => {
                const hasData = c.datasets
                    ? c.datasets.some(d => d.values.some(v => v > 0))
                    : (c.labels && c.labels.length > 0 && c.values.some(v => v > 0)); %>
                <div class="chart-card <%= c.wide ? 'wide' : '' %>">
                    <h3><%= c.title %></h3>
                    <% if (hasData) { %>
                        <div class="chart-box"><canvas id="chart<%= i %>"></canvas></div>
                    <% } else { %>
                        <div class="empty"><%= c.empty || 'No data for the selected filters' %></div>
                    <% } %>
                </div>
            <% }); %>
        </div>
    <% } %>

    <% if (sheet === 'kpis') { %>
        <%- include('partials/kpi_panel', { data, flash, admin, qs }) %>
    <% } %>

    <% (data.tables || []).forEach(t => { %>
        <div class="card">
            <h2><%= t.title %></h2>
            <% if (t.rows.length === 0) { %>
                <div class="empty">Nothing to show for the selected filters.</div>
            <% } else { %>
                <div class="table-wrap">
                <table>
                    <thead><tr><% t.columns.forEach(c => { %><th><%= c %></th><% }); %></tr></thead>
                    <tbody>
                        <% t.rows.forEach(row => { %>
                            <tr>
                                <% row.forEach(cell => { %>
                                    <td>
                                        <% if (cell && typeof cell === 'object' && cell.href) { %>
                                            <a href="<%= cell.href %>"><%= cell.t %></a>
                                        <% } else if (cell && typeof cell === 'object' && cell.b) { %>
                                            <span class="badge <%= cell.b %>"><%= cell.t %></span>
                                        <% } else { %>
                                            <%= cell === null || cell === undefined ? '' : cell %>
                                        <% } %>
                                    </td>
                                <% }); %>
                            </tr>
                        <% }); %>
                    </tbody>
                </table>
                </div>
            <% } %>
        </div>
    <% }); %>

</div>

<script>
    var charts = <%- JSON.stringify(data.charts || []).replace(/</g, '\\u003c') %>;
    charts.forEach(function (c, i) {
        drawChart('chart' + i, {
            type: c.type, labels: c.labels, values: c.values, datasets: c.datasets,
            horizontal: !!c.horizontal, varied: true
        });
    });
</script>

<%- include('partials/footer') %>

</body>
</html>
