<!DOCTYPE html>
<html lang="en" class="pg-incidents-form">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= title %></title>

    <link rel="stylesheet" href="/main.css">
</head>

<body>

<%- include('../partials/topnav') %>


<div class="container">

    <h1>Report New Incident</h1>

    <form action="/incidents/add" method="POST">

        <!-- Incident Date -->
        <div class="form-group">
            <label for="incident_date">Incident Date &amp; Time</label>
            <input
                type="datetime-local"
                id="incident_date"
                name="incident_date"
                required>
        </div>

        <!-- Incident Type -->
        <div class="form-group">
            <label for="incident_type">Incident Type</label>
            <input
                type="text"
                id="incident_type"
                name="incident_type"
                placeholder="e.g. Near Miss, Injury, Spill">
        </div>

        <!-- Severity -->
        <div class="form-group">
            <label for="severity">Severity</label>
            <select id="severity" name="severity">
                <option value="">-- Select Severity --</option>
                <option value="Low">Low</option>
                <option value="Medium">Medium</option>
                <option value="High">High</option>
                <option value="Critical">Critical</option>
            </select>
        </div>

        <!-- Location -->
        <div class="form-group">
            <label for="location">Location</label>
            <input
                type="text"
                id="location"
                name="location"
                placeholder="e.g. Warehouse Bay 3">
        </div>

        <!-- Description -->
        <div class="form-group">
            <label for="description">Description</label>
            <textarea
                id="description"
                name="description"
                placeholder="Describe what happened"></textarea>
        </div>

        <!-- Immediate Action -->
        <div class="form-group">
            <label for="immediate_action">Immediate Action Taken</label>
            <textarea
                id="immediate_action"
                name="immediate_action"
                placeholder="Describe any immediate action taken"></textarea>
        </div>

        <!-- Reported By -->
        <div class="form-group">
            <label for="reported_by">Reported By</label>
            <select id="reported_by" name="reported_by">
                <option value="">-- Select Employee --</option>

                <% employees.forEach(employee => { %>
                    <option
                        value="<%= employee.employee_id %>"
                        data-line-manager="<%= employee.line_manager_id || "" %>">
                        <%= employee.employee_name %>
                    </option>
                <% }); %>

            </select>
        </div>

        <!-- Line Manager -->
        <div class="form-group">
            <label for="line_manager_id">Line Manager</label>
            <select id="line_manager_id" name="line_manager_id">
                <option value="">-- Select Line Manager --</option>

                <% employees.forEach(employee => { %>
                    <option
                        value="<%= employee.employee_id %>">
                        <%= employee.employee_name %>
                    </option>
                <% }); %>

            </select>
        </div>

        <!-- Status -->
        <div class="form-group">
            <label for="status">Status</label>
            <select id="status" name="status">
                <option value="Open" selected>Open</option>
                <option value="Under Investigation">Under Investigation</option>
            </select>
            <small>Incidents close when the Head of Safety signs them off.</small>
        </div>

        <!-- Buttons -->
        <div class="buttons">
            <button type="submit" class="btn btn-save">Save Incident</button>
            <a href="/incidents" class="btn btn-cancel">Cancel</a>
        </div>

    </form>

</div>


<script>
// Picking "Reported By" fills in that employee's line manager (from employee details), unless one is already chosen.
(function () {
    var reporter = document.getElementById("reported_by");
    var manager = document.getElementById("line_manager_id");
    reporter.addEventListener("change", function () {
        var opt = reporter.options[reporter.selectedIndex];
        var lm = opt && opt.getAttribute("data-line-manager");
        if (lm && !manager.value) manager.value = lm;
    });
})();
</script>

<%- include('../partials/footer') %>

</body>
</html>
