<!DOCTYPE html>
<html lang="en" class="pg-incidents-index">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= title %></title>

    <link rel="stylesheet" href="/main.css">
</head>

<body>

<%- include('../partials/topnav') %>


<div class="container">

    <div class="top-bar">
        <h1>Incidents</h1>
        <% if (can.add) { %>
<a href="/incidents/add" class="btn btn-add">+ Report Incident</a>
<% } %>
    </div>

    <%- include('../partials/toolbar') %>



    <% if (incidents.length === 0) { %>

        <div class="empty">No incidents found.</div>

    <% } else { %>

        <div class="table-wrap">
        <table>
            <thead>
                <tr>
                    <th>ID</th>
                    <th>Date</th>
                    <th>Type</th>
                    <th>Severity</th>
                    <th>Location</th>
                    <th>Reported By</th>
                    <th>Line Manager</th>
                    <th>Status</th>
                    <th>Actions</th>
                </tr>
            </thead>
            <tbody>

                <% incidents.forEach(incident => {

                    const sevClass = incident.severity
                        ? "severity-" + incident.severity.toLowerCase()
                        : "severity-default";

                    const statClass = incident.status === "Open"
                        ? "status-open"
                        : incident.status === "Closed"
                            ? "status-closed"
                            : "status-default";
                %>

                    <tr>
                        <td><%= incident.incident_id %></td>
                        <td><%= new Date(incident.incident_date).toLocaleString() %></td>
                        <td><%= incident.incident_type || "-" %></td>
                        <td>
                            <span class="badge <%= sevClass %>">
                                <%= incident.severity || "N/A" %>
                            </span>
                        </td>
                        <td><%= incident.location || "-" %></td>
                        <td><%= incident.reported_by_name || "-" %></td>
                        <td><%= incident.line_manager_name || "-" %></td>
                        <td>
                            <span class="badge <%= statClass %>">
                                <%= incident.status || "N/A" %>
                            </span>
                        </td>
                        <td class="actions">

                            <a href="/incidents/view/<%= incident.incident_id %>" class="btn btn-view">View</a>
                            <% if (can.edit) { %>
<a href="/incidents/edit/<%= incident.incident_id %>" class="btn btn-edit">Edit</a>
<% } %>

                            <% if (can.delete) { %>
<form
                                class="inline"
                                action="/incidents/delete/<%= incident.incident_id %>"
                                method="POST"
                                onsubmit="return confirm('Delete this incident?');">
                                <button type="submit" class="btn btn-delete">Delete</button>
                            </form>
<% } %>

                        </td>
                    </tr>

                <% }); %>

            </tbody>
        </table>
        </div>

    <% } %>

</div>

<%- include('../partials/footer') %>

</body>
</html>
