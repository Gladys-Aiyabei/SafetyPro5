<!DOCTYPE html>
<html lang="en" class="pg-incidents-form">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= title %></title>

    <link rel="stylesheet" href="/main.css">
</head>

<body>

<%- include('../partials/topnav') %>


<div class="container">

    <h1>Edit Incident</h1>

    <form action="/incidents/edit/<%= incident.incident_id %>" method="POST">

        <!-- Incident Date -->
        <div class="form-group">
            <label for="incident_date">Incident Date &amp; Time</label>
            <input
                type="datetime-local"
                id="incident_date"
                name="incident_date"
                value="<%= new Date(incident.incident_date.getTime() - incident.incident_date.getTimezoneOffset() * 60000).toISOString().slice(0, 16) %>"
                required>
        </div>

        <!-- Incident Type -->
        <div class="form-group">
            <label for="incident_type">Incident Type</label>
            <input
                type="text"
                id="incident_type"
                name="incident_type"
                value="<%= incident.incident_type || '' %>">
        </div>

        <!-- Severity -->
        <div class="form-group">
            <label for="severity">Severity</label>
            <select id="severity" name="severity">
                <option value="" <%= !incident.severity ? "selected" : "" %>>-- Select Severity --</option>
                <option value="Low" <%= incident.severity === "Low" ? "selected" : "" %>>Low</option>
                <option value="Medium" <%= incident.severity === "Medium" ? "selected" : "" %>>Medium</option>
                <option value="High" <%= incident.severity === "High" ? "selected" : "" %>>High</option>
                <option value="Critical" <%= incident.severity === "Critical" ? "selected" : "" %>>Critical</option>
            </select>
        </div>

        <!-- Location -->
        <div class="form-group">
            <label for="location">Location</label>
            <input
                type="text"
                id="location"
                name="location"
                value="<%= incident.location || '' %>">
        </div>

        <!-- Description -->
        <div class="form-group">
            <label for="description">Description</label>
            <textarea
                id="description"
                name="description"><%= incident.description || '' %></textarea>
        </div>

        <!-- Immediate Action -->
        <div class="form-group">
            <label for="immediate_action">Immediate Action Taken</label>
            <textarea
                id="immediate_action"
                name="immediate_action"><%= incident.immediate_action || '' %></textarea>
        </div>

        <!-- Reported By -->
        <div class="form-group">
            <label for="reported_by">Reported By</label>
            <select id="reported_by" name="reported_by">
                <option value="">-- Select Employee --</option>

                <% employees.forEach(employee => { %>
                    <option
                        value="<%= employee.employee_id %>"
                        data-line-manager="<%= employee.line_manager_id || "" %>"
                        <%= incident.reported_by === employee.employee_id ? "selected" : "" %>>
                        <%= employee.employee_name %>
                    </option>
                <% }); %>

            </select>
        </div>

        <!-- Line Manager -->
        <div class="form-group">
            <label for="line_manager_id">Line Manager</label>
            <select id="line_manager_id" name="line_manager_id">
                <option value="">-- Select Line Manager --</option>

                <% employees.forEach(employee => { %>
                    <option
                        value="<%= employee.employee_id %>"
                        <%= incident.line_manager_id === employee.employee_id ? "selected" : "" %>>
                        <%= employee.employee_name %>
                    </option>
                <% }); %>

            </select>
        </div>

        <!-- Status -->
        <div class="form-group">
            <label for="status">Status</label>
            <select id="status" name="status">
                <option value="Open" <%= incident.status === "Open" ? "selected" : "" %>>Open</option>
                <option value="Under Investigation" <%= incident.status === "Under Investigation" ? "selected" : "" %>>Under Investigation</option>
                <% if (incident.status === "Closed") { %>
                <option value="Closed" selected>Closed</option>
                <% } %>
            </select>
        </div>

        <!-- Buttons -->
        <div class="buttons">
            <button type="submit" class="btn btn-save">Update Incident</button>
            <a href="/incidents" class="btn btn-cancel">Cancel</a>
        </div>

    </form>

</div>


<script>
// Picking "Reported By" fills in that employee's line manager (from employee details), unless one is already chosen.
(function () {
    var reporter = document.getElementById("reported_by");
    var manager = document.getElementById("line_manager_id");
    reporter.addEventListener("change", function () {
        var opt = reporter.options[reporter.selectedIndex];
        var lm = opt && opt.getAttribute("data-line-manager");
        if (lm && !manager.value) manager.value = lm;
    });
})();
</script>

<%- include('../partials/footer') %>

</body>
</html>
