<!DOCTYPE html>
<html lang="en" class="pg-incidents-view">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= title %></title>

    <link rel="stylesheet" href="/main.css">
</head>

<body>

<%- include('../partials/topnav') %>


<div class="container">

    <h1>Incident Details</h1>

    <% const sevClass = incident.severity
        ? "severity-" + incident.severity.toLowerCase()
        : "severity-default"; %>

    <% const statClass = incident.status === "Open"
        ? "status-open"
        : incident.status === "Closed"
            ? "status-closed"
            : "status-default"; %>

    <div class="field">
        <label>Incident ID</label>
        <div><%= incident.incident_id %></div>
    </div>

    <div class="field">
        <label>Incident Date &amp; Time</label>
        <div><%= new Date(incident.incident_date).toLocaleString() %></div>
    </div>

    <div class="field">
        <label>Incident Type</label>
        <div><%= incident.incident_type || "-" %></div>
    </div>

    <div class="field">
        <label>Classification</label>
        <div><%= incident.classification || "Not classified yet" %></div>
    </div>

    <div class="field">
        <label>Severity</label>
        <div>
            <span class="badge <%= sevClass %>">
                <%= incident.severity || "N/A" %>
            </span>
        </div>
    </div>

    <div class="field">
        <label>Location</label>
        <div><%= incident.location || "-" %></div>
    </div>

    <div class="field">
        <label>Description</label>
        <div class="text-block"><%= incident.description || "-" %></div>
    </div>

    <div class="field">
        <label>Immediate Action Taken</label>
        <div class="text-block"><%= incident.immediate_action || "-" %></div>
    </div>

    <div class="field">
        <label>Reported By</label>
        <div><%= incident.reported_by_name || "-" %></div>
    </div>

    <div class="field">
        <label>Line Manager</label>
        <div><%= incident.line_manager_name || "-" %></div>
    </div>

    <div class="field">
        <label>Status</label>
        <div>
            <span class="badge <%= statClass %>">
                <%= incident.status || "N/A" %>
            </span>
        </div>
    </div>

    <%- include('_investigation') %>

    <div class="buttons">
        <% if (can.edit) { %>
<a href="/incidents/edit/<%= incident.incident_id %>" class="btn btn-edit">Edit</a>
<% } %>
        <a href="/incidents" class="btn btn-back">Back to List</a>
    </div>

</div>

<%- include('../partials/footer') %>

</body>
</html>
