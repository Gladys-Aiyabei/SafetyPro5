<!DOCTYPE html>
<html lang="en" class="pg-training-gap-analysis">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>Training Requirements — SafetyPro</title>

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>

    <link
        href="https://fonts.googleapis.com/css2?family=Archivo+Expanded:wght@600;700;800&family=Inter:wght@400;500;600;700&family=IBM+Plex+Mono:wght@500&display=swap"
        rel="stylesheet"
    >

    <link rel="stylesheet" href="/main.css">
</head>

<body>

<%- include('partials/topnav') %>


<!-- ==========================================
     HEADER
========================================== -->

<!-- ==========================================
     MAIN CONTENT
========================================== -->

<main>

    <div class="page-head">

        <div>

            <h1>
                Training requirements
            </h1>

            <p>
                <%= Array.isArray(requirements) ? requirements.length : 0 %>

                requirement

                <%= Array.isArray(requirements) && requirements.length === 1 ? '' : 's' %>

                defined, by role
            </p>

        </div>


        <% if (can.add) { %>
<button
            type="button"
            class="btn btn-primary"
            onclick="openModal()"
        >
            + Add requirement
        </button>
<% } %>

    </div>


    <!-- ==========================================
         FLASH MESSAGE
    ========================================== -->

    <% if (typeof flash !== 'undefined' && flash) { %>

        <div class="flash">
            <%= flash %>
        </div>

    <% } %>


    <!-- ==========================================
         ERROR MESSAGE
    ========================================== -->

    <% if (typeof error !== 'undefined' && error) { %>

        <div class="flash error">
            <%= error %>
        </div>

    <% } %>


    <!-- ==========================================
         TRAINING REQUIREMENTS TABLE
    ========================================== -->

    <div class="table-wrapper">

        <table>

            <thead>

                <tr>

                    <th>
                        Role
                    </th>

                    <th>
                        Required training
                    </th>

                    <th>
                        Valid for
                    </th>

                    <th>
                        Actions
                    </th>

                </tr>

            </thead>


            <tbody>

                <% if (!requirements || requirements.length === 0) { %>

                    <tr>

                        <td colspan="4">

                            <div class="empty">

                                No training requirements yet —
                                add your first one.

                            </div>

                        </td>

                    </tr>

                <% } else { %>


                    <% requirements.forEach(function(r) { %>

                        <%
                            var roleMatch = (roles || []).find(
                                function(role) {
                                    return String(role.role_id) === String(r.role_id);
                                }
                            );
                        %>


                        <tr>

                            <!-- ROLE -->

                            <td class="name">

                                <%= roleMatch
                                    ? (roleMatch.role_name || roleMatch.name || ('Role #' + r.role_id))
                                    : ('Role #' + r.role_id)
                                %>

                            </td>


                            <!-- TRAINING -->

                            <td>

                                <%= r.required_training %>

                            </td>


                            <!-- VALIDITY -->

                            <td>

                                <span class="pill">

                                    <%= r.validity_months || 12 %>

                                    month<%= Number(r.validity_months || 12) === 1 ? '' : 's' %>

                                </span>

                            </td>


                            <!-- ACTIONS -->

                            <td>

                                <div class="row-actions">


                                    <!-- EDIT -->

                                    <% if (can.edit) { %>
<button
                                        type="button"
                                        class="btn btn-ghost btn-small edit-btn"
                                        data-id="<%= r.requirement_id %>"
                                        data-role-id="<%= r.role_id %>"
                                        data-training="<%= r.required_training %>"
                                        data-validity="<%= r.validity_months || 12 %>"
                                    >
                                        Edit
                                    </button>
<% } %>


                                    <!-- DELETE -->

                                    <% if (can.delete) { %>
<form
                                        method="POST"
                                        action="/training/gap-analysis/<%= r.requirement_id %>/delete"
                                        onsubmit="return confirm('Delete this training requirement?');"
                                        style="display:inline;"
                                    >

                                        <button
                                            type="submit"
                                            class="btn btn-danger btn-small"
                                        >
                                            Delete
                                        </button>

                                    </form>
<% } %>

                                </div>

                            </td>

                        </tr>


                    <% }); %>

                <% } %>

            </tbody>

        </table>

    </div>

</main>


<!-- ==========================================
     ADD / EDIT MODAL
========================================== -->

<div
    class="overlay"
    id="overlay"
>

    <div
        class="modal"
        role="dialog"
        aria-modal="true"
        aria-labelledby="modalTitle"
    >

        <h2 id="modalTitle">
            Add requirement
        </h2>


        <form
            id="reqForm"
            method="POST"
            action="/training/gap-analysis"
        >


            <!-- ROLE -->

            <div class="field">

                <label for="role_id">
                    Role
                </label>


                <% if (roles && roles.length > 0) { %>


                    <select
                        id="role_id"
                        name="role_id"
                        required
                    >

                        <option value="">
                            Select a role
                        </option>


                        <% roles.forEach(function(role) { %>

                            <option
                                value="<%= role.role_id %>"
                            >
                                <%= role.role_name || role.name || ('Role #' + role.role_id) %>
                            </option>

                        <% }); %>

                    </select>


                <% } else { %>


                    <input
                        type="number"
                        id="role_id"
                        name="role_id"
                        min="1"
                        required
                        placeholder="Enter role ID"
                    >


                    <p class="hint">

                        No roles were found.

                        Enter the role ID manually.

                    </p>


                <% } %>

            </div>


            <!-- REQUIRED TRAINING -->

            <div class="field">

                <label for="required_training">
                    Required training
                </label>

                <input
                    type="text"
                    id="required_training"
                    name="required_training"
                    required
                    maxlength="255"
                    placeholder="e.g. Working at Heights"
                >

            </div>


            <!-- VALIDITY -->

            <div class="field">

                <label for="validity_months">
                    Valid for (months)
                </label>

                <input
                    type="number"
                    id="validity_months"
                    name="validity_months"
                    min="1"
                    max="120"
                    value="12"
                    required
                >

            </div>


            <!-- MODAL BUTTONS -->

            <div class="modal-actions">

                <button
                    type="button"
                    class="btn btn-ghost"
                    onclick="closeModal()"
                >
                    Cancel
                </button>


                <button
                    type="submit"
                    class="btn btn-primary"
                    id="submitBtn"
                >
                    Save requirement
                </button>

            </div>

        </form>

    </div>

</div>


<!-- ==========================================
     JAVASCRIPT
========================================== -->

<script>

    const overlay =
        document.getElementById("overlay");

    const form =
        document.getElementById("reqForm");

    const modalTitle =
        document.getElementById("modalTitle");

    const submitBtn =
        document.getElementById("submitBtn");

    const roleInput =
        document.getElementById("role_id");

    const trainingInput =
        document.getElementById("required_training");

    const validityInput =
        document.getElementById("validity_months");


    // ==========================================
    // OPEN MODAL
    // ==========================================

    function openModal(req) {

        form.reset();

        if (req) {

            modalTitle.textContent =
                "Edit requirement";

            submitBtn.textContent =
                "Save changes";

            form.action =
                "/training/gap-analysis/" +
                req.id +
                "/update";

            roleInput.value =
                req.roleId || "";

            trainingInput.value =
                req.training || "";

            validityInput.value =
                req.validity || 12;

        } else {

            modalTitle.textContent =
                "Add requirement";

            submitBtn.textContent =
                "Save requirement";

            form.action =
                "/training/gap-analysis";

            validityInput.value = 12;
        }

        overlay.classList.add("open");

        setTimeout(function() {

            if (roleInput) {
                roleInput.focus();
            }

        }, 50);
    }


    // ==========================================
    // CLOSE MODAL
    // ==========================================

    function closeModal() {

        overlay.classList.remove("open");

        form.reset();

        modalTitle.textContent =
            "Add requirement";

        submitBtn.textContent =
            "Save requirement";

        form.action =
            "/training/gap-analysis";
    }


    // ==========================================
    // CLICK OUTSIDE MODAL
    // ==========================================

    overlay.addEventListener(
        "click",
        function(event) {

            if (event.target === overlay) {

                closeModal();

            }

        }
    );


    // ==========================================
    // ESCAPE KEY
    // ==========================================

    document.addEventListener(
        "keydown",
        function(event) {

            if (
                event.key === "Escape" &&
                overlay.classList.contains("open")
            ) {

                closeModal();

            }

        }
    );


    // ==========================================
    // EDIT BUTTONS
    // ==========================================

    document
        .querySelectorAll(".edit-btn")
        .forEach(function(button) {

            button.addEventListener(
                "click",
                function() {

                    openModal({

                        id:
                            button.dataset.id,

                        roleId:
                            button.dataset.roleId,

                        training:
                            button.dataset.training,

                        validity:
                            button.dataset.validity

                    });

                }
            );

        });

</script>

<%- include('partials/footer') %>

</body>
</html>