<!DOCTYPE html>
<html lang="en" class="pg-risk-assesments">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Risk Assessments &mdash; SafetyPro</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Archivo+Expanded:wght@600;700;800&family=Inter:wght@400;500;600;700&family=IBM+Plex+Mono:wght@500&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="/main.css">
</head>
<body>

<%- include('partials/topnav') %>

<main>
  <div class="page-head">
    <div>
      <h1>Risk assessments</h1>
      <p><%= risks.length %> assessment<%= risks.length === 1 ? '' : 's' %> on record</p>
    </div>
    <% if (can.add) { %>
    <button class="btn btn-primary" onclick="openModal()">+ New assessment</button>
    <% } %>
  </div>

  <%- include('partials/toolbar') %>


  <% if (typeof flash !== 'undefined' && flash) { %>
    <div class="flash"><%= flash %></div>
  <% } %>
  <% if (typeof error !== 'undefined' && error) { %>
    <div class="flash error"><%= error %></div>
  <% } %>

  <table>
    <thead>
      <tr>
        <th>Activity</th>
        <th>Hazard</th>
        <th>Likelihood &times; Severity</th>
        <th>Score</th>
        <th>Risk level</th>
        <th>Assessed</th>
        <th></th>
      </tr>
    </thead>
    <tbody>
      <% if (risks.length === 0) { %>
        <tr><td colspan="7"><div class="empty">No risk assessments yet &mdash; add your first one.</div></td></tr>
      <% } %>
      <% risks.forEach(function(r) { %>
        <tr>
          <td class="name">
            <%= r.activity %>
            <% if (r.consequence) { %>
              <br><span class="sub"><%= r.consequence.slice(0, 60) %></span>
            <% } %>
          </td>
          <td><%= r.hazard || '&mdash;' %></td>
          <td><%= r.likelihood != null ? r.likelihood : '&mdash;' %> &times; <%= r.severity != null ? r.severity : '&mdash;' %></td>
          <td><%= r.risk_score != null ? r.risk_score : '&mdash;' %></td>
          <td>
            <span class="risk-pill <%= (r.risk_level || '').toLowerCase() %>">
              <%= r.risk_level || 'Unrated' %>
            </span>
          </td>
          <td><%= r.assessment_date ? new Date(r.assessment_date).toLocaleDateString() : '&mdash;' %></td>
          <td>
            <div class="row-actions">
              <a class="btn btn-ghost btn-small" href="/findings/risks/<%= r.risk_id %>">Findings</a>
              <% if (can.edit) { %>
<button class="btn btn-ghost btn-small edit-btn"
                data-risk='<%= JSON.stringify(r) %>'>Edit</button>
<% } %>
              <% if (can.delete) { %>
<form method="POST" action="/risk-assessments/<%= r.risk_id %>/delete"
                onsubmit="return confirm('Delete this risk assessment?');" style="display:inline;">
                <button type="submit" class="btn btn-danger btn-small">Delete</button>
              </form>
<% } %>
            </div>
          </td>
        </tr>
      <% }) %>
    </tbody>
  </table>
</main>

<!-- Add / Edit modal -->
<div class="overlay" id="overlay">
  <div class="modal">
    <h2 id="modalTitle">New assessment</h2>
    <form id="riskForm" method="POST" action="/risk-assessments">
      <div class="form-grid">
        <div class="field span-2">
          <label for="activity">Activity</label>
          <input type="text" id="activity" name="activity" required>
        </div>
        <div class="field span-2">
          <label for="hazard">Hazard</label>
          <input type="text" id="hazard" name="hazard">
        </div>
        <div class="field span-2">
          <label for="consequence">Consequence</label>
          <input type="text" id="consequence" name="consequence">
        </div>
        <div class="field">
          <label for="likelihood">Likelihood (1&ndash;5)</label>
          <select id="likelihood" name="likelihood">
            <option value="1">1 &ndash; Rare</option>
            <option value="2">2 &ndash; Unlikely</option>
            <option value="3">3 &ndash; Possible</option>
            <option value="4">4 &ndash; Likely</option>
            <option value="5">5 &ndash; Almost certain</option>
          </select>
        </div>
        <div class="field">
          <label for="severity">Severity (1&ndash;5)</label>
          <select id="severity" name="severity">
            <option value="1">1 &ndash; Negligible</option>
            <option value="2">2 &ndash; Minor</option>
            <option value="3">3 &ndash; Moderate</option>
            <option value="4">4 &ndash; Major</option>
            <option value="5">5 &ndash; Catastrophic</option>
          </select>
        </div>
        <div class="field span-2">
          <div class="computed-row">
            <span>Risk score (likelihood &times; severity)</span>
            <strong id="scoreDisplay">1</strong>
          </div>
          <input type="hidden" id="risk_score" name="risk_score" value="1">
        </div>
        <div class="field span-2">
          <div class="computed-row">
            <span>Risk level</span>
            <strong id="levelDisplay">Low</strong>
          </div>
          <input type="hidden" id="risk_level" name="risk_level" value="Low">
        </div>
        <div class="field span-2">
          <label for="control_measures">Control measures</label>
          <textarea id="control_measures" name="control_measures"></textarea>
        </div>
        <div class="field">
          <label for="responsible_person">Responsible person (employee ID)</label>
          <input type="number" id="responsible_person" name="responsible_person" min="1">
        </div>
        <div class="field">
          <label for="assessment_date">Assessment date</label>
          <input type="date" id="assessment_date" name="assessment_date">
        </div>
        <div class="field">
          <label for="location">Location</label>
          <input type="text" id="location" name="location" placeholder="e.g. Nairobi">
        </div>
      </div>
      <div class="modal-actions">
        <button type="button" class="btn btn-ghost" onclick="closeModal()">Cancel</button>
        <button type="submit" class="btn btn-primary" id="submitBtn">Save assessment</button>
      </div>
    </form>
  </div>
</div>

<script>
  const overlay = document.getElementById('overlay');
  const form = document.getElementById('riskForm');
  const modalTitle = document.getElementById('modalTitle');
  const submitBtn = document.getElementById('submitBtn');
  const likelihoodSel = document.getElementById('likelihood');
  const severitySel = document.getElementById('severity');
  const scoreDisplay = document.getElementById('scoreDisplay');
  const levelDisplay = document.getElementById('levelDisplay');
  const scoreInput = document.getElementById('risk_score');
  const levelInput = document.getElementById('risk_level');

  // Standard 5x5 risk matrix bands. Adjust the cutoffs here if your
  // organization uses different thresholds.
  function levelFor(score) {
    if (score <= 4) return 'Low';
    if (score <= 9) return 'Medium';
    if (score <= 15) return 'High';
    return 'Critical';
  }

  function recompute() {
    const l = Number(likelihoodSel.value) || 1;
    const s = Number(severitySel.value) || 1;
    const score = l * s;
    const level = levelFor(score);
    scoreDisplay.textContent = score;
    levelDisplay.textContent = level;
    scoreInput.value = score;
    levelInput.value = level;
  }

  likelihoodSel.addEventListener('change', recompute);
  severitySel.addEventListener('change', recompute);

  function toDateInputValue(value) {
    if (!value) return '';
    const d = new Date(value);
    if (isNaN(d)) return '';
    return d.toISOString().slice(0, 10);
  }

  function openModal(risk) {
    form.reset();
    if (risk && risk.risk_id) {
      modalTitle.textContent = 'Edit assessment';
      submitBtn.textContent = 'Save changes';
      form.action = '/risk-assessments/' + risk.risk_id + '/update';
      document.getElementById('activity').value = risk.activity || '';
      document.getElementById('hazard').value = risk.hazard || '';
      document.getElementById('consequence').value = risk.consequence || '';
      likelihoodSel.value = risk.likelihood || 1;
      severitySel.value = risk.severity || 1;
      document.getElementById('control_measures').value = risk.control_measures || '';
      document.getElementById('responsible_person').value = risk.responsible_person || '';
      document.getElementById('assessment_date').value = toDateInputValue(risk.assessment_date);
      document.getElementById('location').value = risk.location || '';
    } else {
      modalTitle.textContent = 'New assessment';
      submitBtn.textContent = 'Save assessment';
      form.action = '/risk-assessments';
      likelihoodSel.value = 1;
      severitySel.value = 1;
    }
    recompute();
    overlay.classList.add('open');
  }

  function closeModal() {
    overlay.classList.remove('open');
  }

  overlay.addEventListener('click', function (e) {
    if (e.target === overlay) closeModal();
  });

  // Edit buttons carry their row's data in a data-risk attribute
  // (HTML-escaped by EJS's <%= %>), so quotes/special characters in
  // any field can't break the inline markup.
  document.querySelectorAll('.edit-btn').forEach(function (btn) {
    btn.addEventListener('click', function () {
      const risk = JSON.parse(btn.getAttribute('data-risk'));
      openModal(risk);
    });
  });
</script>

<%- include('partials/footer') %>

</body>
</html>
