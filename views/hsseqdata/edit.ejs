<!DOCTYPE html>
<html lang="en" class="pg-hsseqdata-form">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= title %></title>

    <link rel="stylesheet" href="/main.css">
</head>

<body>

<%- include('../partials/topnav') %>


<div class="container">

    <h1>Edit HSSEQ Record</h1>

    <form action="/hsseq/edit/<%= record.hsseq_id %>" method="POST">

        <div class="section-title">Period</div>

        <div class="form-row">

            <div class="form-group">
                <label for="record_month">Month</label>
                <select id="record_month" name="record_month" required>
                    <option value="">-- Select Month --</option>
                    <% const months = [
                        "January", "February", "March", "April", "May", "June",
                        "July", "August", "September", "October", "November", "December"
                    ]; %>
                    <% months.forEach((m, i) => { %>
                        <option value="<%= i + 1 %>" <%= record.record_month === (i + 1) ? "selected" : "" %>>
                            <%= m %>
                        </option>
                    <% }); %>
                </select>
            </div>

            <div class="form-group">
                <label for="record_year">Year</label>
                <input
                    type="number"
                    id="record_year"
                    name="record_year"
                    value="<%= record.record_year %>"
                    min="2000"
                    max="2100"
                    required>
            </div>

        </div>

        <div class="section-title">Waste &amp; Water</div>

        <div class="form-row">

            <div class="form-group">
                <label for="hazardous_waste_tonnes">Hazardous Waste (tonnes)</label>
                <input
                    type="number"
                    step="0.01"
                    id="hazardous_waste_tonnes"
                    name="hazardous_waste_tonnes"
                    value="<%= record.hazardous_waste_tonnes %>">
            </div>

            <div class="form-group">
                <label for="non_hazardous_waste_tonnes">Non-Hazardous Waste (tonnes)</label>
                <input
                    type="number"
                    step="0.01"
                    id="non_hazardous_waste_tonnes"
                    name="non_hazardous_waste_tonnes"
                    value="<%= record.non_hazardous_waste_tonnes %>">
            </div>

        </div>

        <div class="form-group">
            <label for="water_consumption_m3">Water Consumption (m3)</label>
            <input
                type="number"
                step="0.01"
                id="water_consumption_m3"
                name="water_consumption_m3"
                value="<%= record.water_consumption_m3 %>">
        </div>

        <div class="section-title">Exposure Hours</div>

        <div class="form-row">

            <div class="form-group">
                <label for="exposure_hours_contractors">Contractors</label>
                <input
                    type="number"
                    step="0.01"
                    id="exposure_hours_contractors"
                    name="exposure_hours_contractors"
                    value="<%= record.exposure_hours_contractors %>">
            </div>

            <div class="form-group">
                <label for="exposure_hours_staff">Staff</label>
                <input
                    type="number"
                    step="0.01"
                    id="exposure_hours_staff"
                    name="exposure_hours_staff"
                    value="<%= record.exposure_hours_staff %>">
            </div>

        </div>

        <div class="section-title">Fleet &amp; Emissions</div>

        <div class="form-row">

            <div class="form-group">
                <label for="kms_light_vehicles">Km - Light Vehicles</label>
                <input
                    type="number"
                    step="0.01"
                    id="kms_light_vehicles"
                    name="kms_light_vehicles"
                    value="<%= record.kms_light_vehicles %>">
            </div>

            <div class="form-group">
                <label for="kms_heavy_goods_vehicles">Km - Heavy Goods Vehicles</label>
                <input
                    type="number"
                    step="0.01"
                    id="kms_heavy_goods_vehicles"
                    name="kms_heavy_goods_vehicles"
                    value="<%= record.kms_heavy_goods_vehicles %>">
            </div>

        </div>

        <div class="form-group">
            <label for="ghg_emissions_tonnes">GHG Emissions (tonnes)</label>
            <input
                type="number"
                step="0.01"
                id="ghg_emissions_tonnes"
                name="ghg_emissions_tonnes"
                value="<%= record.ghg_emissions_tonnes %>">
        </div>

        <div class="section-title">Location</div>

        <div class="form-group">
            <label for="location">Location / site</label>
            <input type="text" id="location" name="location" placeholder="e.g. Nairobi" value="<%= record.location || '' %>">
        </div>

        <div class="section-title">Attachment</div>

        <div class="form-row">

            <div class="form-group">
                <label for="attachment_path">Attachment Path</label>
                <input
                    type="text"
                    id="attachment_path"
                    name="attachment_path"
                    value="<%= record.attachment_path || '' %>">
            </div>

            <div class="form-group">
                <label for="file_type">File Type</label>
                <select id="file_type" name="file_type">
                    <option value="" <%= !record.file_type ? "selected" : "" %>>-- Select Type --</option>
                    <option value="image" <%= record.file_type === "image" ? "selected" : "" %>>Image</option>
                    <option value="document" <%= record.file_type === "document" ? "selected" : "" %>>Document</option>
                </select>
            </div>

        </div>

        <div class="buttons">
            <button type="submit" class="btn btn-save">Update Record</button>
            <a href="/hsseq" class="btn btn-cancel">Cancel</a>
        </div>

    </form>

</div>

<%- include('../partials/footer') %>

</body>
</html>
