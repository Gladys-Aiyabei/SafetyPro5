<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= title %></title>

    <style>

        body {
            font-family: Arial, sans-serif;
            background: #f4f6f9;
            padding: 30px;
        }

        .container {
            max-width: 800px;
            margin: auto;
            background: white;
            padding: 30px;
            border-radius: 8px;
        }

        h1 {
            margin-bottom: 25px;
        }

        .form-row {
            display: flex;
            gap: 16px;
        }

        .form-row .form-group {
            flex: 1;
        }

        .form-group {
            margin-bottom: 18px;
        }

        label {
            display: block;
            margin-bottom: 6px;
            font-weight: bold;
        }

        input,
        select {
            width: 100%;
            padding: 10px;
            box-sizing: border-box;
            border: 1px solid #ccc;
            border-radius: 5px;
        }

        .section-title {
            margin-top: 10px;
            margin-bottom: 12px;
            padding-bottom: 6px;
            border-bottom: 2px solid #f0f0f0;
            font-size: 15px;
            color: #555;
            text-transform: uppercase;
            letter-spacing: 0.5px;
        }

        .btn {
            padding: 10px 18px;
            border: none;
            border-radius: 5px;
            cursor: pointer;
            color: white;
            text-decoration: none;
        }

        .btn-save {
            background: #198754;
        }

        .btn-cancel {
            background: #6c757d;
        }

        .buttons {
            margin-top: 20px;
            display: flex;
            gap: 10px;
        }

    </style>
</head>

<body>

<div class="container">

    <h1>Add HSSEQ Record</h1>

    <form action="/hsseq/add" method="POST">

        <div class="section-title">Period</div>

        <div class="form-row">

            <div class="form-group">
                <label for="record_month">Month</label>
                <select id="record_month" name="record_month" required>
                    <option value="">-- Select Month --</option>
                    <option value="1">January</option>
                    <option value="2">February</option>
                    <option value="3">March</option>
                    <option value="4">April</option>
                    <option value="5">May</option>
                    <option value="6">June</option>
                    <option value="7">July</option>
                    <option value="8">August</option>
                    <option value="9">September</option>
                    <option value="10">October</option>
                    <option value="11">November</option>
                    <option value="12">December</option>
                </select>
            </div>

            <div class="form-group">
                <label for="record_year">Year</label>
                <input
                    type="number"
                    id="record_year"
                    name="record_year"
                    placeholder="e.g. 2026"
                    min="2000"
                    max="2100"
                    required>
            </div>

        </div>

        <div class="section-title">Waste &amp; Water</div>

        <div class="form-row">

            <div class="form-group">
                <label for="hazardous_waste_tonnes">Hazardous Waste (tonnes)</label>
                <input
                    type="number"
                    step="0.01"
                    id="hazardous_waste_tonnes"
                    name="hazardous_waste_tonnes"
                    value="0.00">
            </div>

            <div class="form-group">
                <label for="non_hazardous_waste_tonnes">Non-Hazardous Waste (tonnes)</label>
                <input
                    type="number"
                    step="0.01"
                    id="non_hazardous_waste_tonnes"
                    name="non_hazardous_waste_tonnes"
                    value="0.00">
            </div>

        </div>

        <div class="form-group">
            <label for="water_consumption_m3">Water Consumption (m3)</label>
            <input
                type="number"
                step="0.01"
                id="water_consumption_m3"
                name="water_consumption_m3"
                value="0.00">
        </div>

        <div class="section-title">Exposure Hours</div>

        <div class="form-row">

            <div class="form-group">
                <label for="exposure_hours_contractors">Contractors</label>
                <input
                    type="number"
                    step="0.01"
                    id="exposure_hours_contractors"
                    name="exposure_hours_contractors"
                    value="0.00">
            </div>

            <div class="form-group">
                <label for="exposure_hours_staff">Staff</label>
                <input
                    type="number"
                    step="0.01"
                    id="exposure_hours_staff"
                    name="exposure_hours_staff"
                    value="0.00">
            </div>

        </div>

        <div class="section-title">Fleet &amp; Emissions</div>

        <div class="form-row">

            <div class="form-group">
                <label for="kms_light_vehicles">Km - Light Vehicles</label>
                <input
                    type="number"
                    step="0.01"
                    id="kms_light_vehicles"
                    name="kms_light_vehicles"
                    value="0.00">
            </div>

            <div class="form-group">
                <label for="kms_heavy_goods_vehicles">Km - Heavy Goods Vehicles</label>
                <input
                    type="number"
                    step="0.01"
                    id="kms_heavy_goods_vehicles"
                    name="kms_heavy_goods_vehicles"
                    value="0.00">
            </div>

        </div>

        <div class="form-group">
            <label for="ghg_emissions_tonnes">GHG Emissions (tonnes)</label>
            <input
                type="number"
                step="0.01"
                id="ghg_emissions_tonnes"
                name="ghg_emissions_tonnes"
                value="0.00">
        </div>

        <div class="section-title">Attachment</div>

        <div class="form-row">

            <div class="form-group">
                <label for="attachment_path">Attachment Path</label>
                <input
                    type="text"
                    id="attachment_path"
                    name="attachment_path"
                    placeholder="e.g. uploads/hsseq/jan2026.pdf">
            </div>

            <div class="form-group">
                <label for="file_type">File Type</label>
                <select id="file_type" name="file_type">
                    <option value="">-- Select Type --</option>
                    <option value="image">Image</option>
                    <option value="document">Document</option>
                </select>
            </div>

        </div>

        <div class="buttons">
            <button type="submit" class="btn btn-save">Save Record</button>
            <a href="/hsseq" class="btn btn-cancel">Cancel</a>
        </div>

    </form>

</div>

</body>
</html>
