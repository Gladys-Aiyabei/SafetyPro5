<!DOCTYPE html>
<html lang="en" class="pg-hsseqdata-view">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= title %></title>

    <link rel="stylesheet" href="/main.css">
</head>

<body>

<%- include('../partials/topnav') %>


<div class="container">

    <h1>HSSEQ Record Details</h1>

    <div class="grid">

        <div class="field">
            <label>Record ID</label>
            <div><%= record.hsseq_id %></div>
        </div>

        <div class="field">
            <label>Month / Year</label>
            <div><%= record.record_month %> / <%= record.record_year %></div>
        </div>

        <div class="section-title">Waste &amp; Water</div>

        <div class="field">
            <label>Hazardous Waste (tonnes)</label>
            <div><%= record.hazardous_waste_tonnes %></div>
        </div>

        <div class="field">
            <label>Non-Hazardous Waste (tonnes)</label>
            <div><%= record.non_hazardous_waste_tonnes %></div>
        </div>

        <div class="field">
            <label>Water Consumption (m3)</label>
            <div><%= record.water_consumption_m3 %></div>
        </div>

        <div class="section-title">Exposure Hours</div>

        <div class="field">
            <label>Contractors</label>
            <div><%= record.exposure_hours_contractors %></div>
        </div>

        <div class="field">
            <label>Staff</label>
            <div><%= record.exposure_hours_staff %></div>
        </div>

        <div class="section-title">Fleet &amp; Emissions</div>

        <div class="field">
            <label>Km - Light Vehicles</label>
            <div><%= record.kms_light_vehicles %></div>
        </div>

        <div class="field">
            <label>Km - Heavy Goods Vehicles</label>
            <div><%= record.kms_heavy_goods_vehicles %></div>
        </div>

        <div class="field">
            <label>GHG Emissions (tonnes)</label>
            <div><%= record.ghg_emissions_tonnes %></div>
        </div>

        <div class="section-title">Attachment</div>

        <div class="field">
            <label>Attachment Path</label>
            <div><%= record.attachment_path || "-" %></div>
        </div>

        <div class="field">
            <label>File Type</label>
            <div><%= record.file_type || "-" %></div>
        </div>

        <div class="section-title">Timestamps</div>

        <div class="field">
            <label>Created At</label>
            <div><%= record.created_at %></div>
        </div>

        <div class="field">
            <label>Updated At</label>
            <div><%= record.updated_at %></div>
        </div>

    </div>

    <div class="buttons">
        <% if (can.edit) { %>
<a href="/hsseq/edit/<%= record.hsseq_id %>" class="btn btn-edit">Edit</a>
<% } %>
        <a href="/hsseq" class="btn btn-back">Back to List</a>
    </div>

</div>

<%- include('../partials/footer') %>

</body>
</html>
