<!DOCTYPE html>
<html lang="en" class="pg-hsseqdata-index">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= title %></title>

    <link rel="stylesheet" href="/main.css">
</head>

<body>

<%- include('../partials/topnav') %>


<div class="container">

    <div class="top-bar">
        <h1>HSSEQ Data</h1>
        <% if (can.add) { %>
<a href="/hsseq/add" class="btn btn-add">+ Add Record</a>
<% } %>
    </div>

    <%- include('../partials/toolbar') %>



    <% if (records.length === 0) { %>

        <div class="empty">No HSSEQ records found.</div>

    <% } else { %>

        <div class="table-wrap">
        <table>
            <thead>
                <tr>
                    <th>ID</th>
                    <th>Month</th>
                    <th>Year</th>
                    <th>Hazardous Waste (t)</th>
                    <th>Non-Hazardous Waste (t)</th>
                    <th>Water (m3)</th>
                    <th>Exposure Hrs (Contractors)</th>
                    <th>Exposure Hrs (Staff)</th>
                    <th>Km (Light Vehicles)</th>
                    <th>Km (Heavy Vehicles)</th>
                    <th>GHG Emissions (t)</th>
                    <th>File Type</th>
                    <th>Actions</th>
                </tr>
            </thead>
            <tbody>

                <% records.forEach(record => { %>

                    <tr>
                        <td><%= record.hsseq_id %></td>
                        <td><%= record.record_month %></td>
                        <td><%= record.record_year %></td>
                        <td><%= record.hazardous_waste_tonnes %></td>
                        <td><%= record.non_hazardous_waste_tonnes %></td>
                        <td><%= record.water_consumption_m3 %></td>
                        <td><%= record.exposure_hours_contractors %></td>
                        <td><%= record.exposure_hours_staff %></td>
                        <td><%= record.kms_light_vehicles %></td>
                        <td><%= record.kms_heavy_goods_vehicles %></td>
                        <td><%= record.ghg_emissions_tonnes %></td>
                        <td><%= record.file_type || "-" %></td>
                        <td class="actions">

                            <a href="/hsseq/view/<%= record.hsseq_id %>" class="btn btn-view">View</a>
                            <% if (can.edit) { %>
<a href="/hsseq/edit/<%= record.hsseq_id %>" class="btn btn-edit">Edit</a>
<% } %>

                            <% if (can.delete) { %>
<form
                                class="inline"
                                action="/hsseq/delete/<%= record.hsseq_id %>"
                                method="POST"
                                onsubmit="return confirm('Delete this record?');">
                                <button type="submit" class="btn btn-delete">Delete</button>
                            </form>
<% } %>

                        </td>
                    </tr>

                <% }); %>

            </tbody>
        </table>
        </div>

    <% } %>

</div>

<%- include('../partials/footer') %>

</body>
</html>
