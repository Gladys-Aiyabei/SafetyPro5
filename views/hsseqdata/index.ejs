<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= title %></title>

    <style>

        body {
            font-family: Arial, sans-serif;
            background: #f4f6f9;
            padding: 30px;
        }

        .container {
            max-width: 1300px;
            margin: auto;
            background: white;
            padding: 30px;
            border-radius: 8px;
        }

        h1 {
            margin-bottom: 20px;
        }

        .top-bar {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-bottom: 20px;
        }

        table {
            width: 100%;
            border-collapse: collapse;
        }

        th, td {
            padding: 10px;
            text-align: left;
            border-bottom: 1px solid #eee;
            font-size: 13px;
            white-space: nowrap;
        }

        th {
            background: #f8f9fa;
        }

        .table-wrap {
            overflow-x: auto;
        }

        .btn {
            padding: 8px 14px;
            border: none;
            border-radius: 5px;
            cursor: pointer;
            color: white;
            text-decoration: none;
            font-size: 14px;
        }

        .btn-add {
            background: #0d6efd;
        }

        .btn-view {
            background: #0dcaf0;
        }

        .btn-edit {
            background: #ffc107;
            color: #000;
        }

        .btn-delete {
            background: #dc3545;
        }

        .actions {
            display: flex;
            gap: 8px;
        }

        form.inline {
            display: inline;
        }

        .empty {
            text-align: center;
            padding: 30px;
            color: #777;
        }

    </style>
</head>

<body>

<div class="container">

    <div class="top-bar">
        <h1>HSSEQ Data</h1>
        <a href="/hsseq/add" class="btn btn-add">+ Add Record</a>
    </div>

    <% if (records.length === 0) { %>

        <div class="empty">No HSSEQ records found.</div>

    <% } else { %>

        <div class="table-wrap">
        <table>
            <thead>
                <tr>
                    <th>ID</th>
                    <th>Month</th>
                    <th>Year</th>
                    <th>Hazardous Waste (t)</th>
                    <th>Non-Hazardous Waste (t)</th>
                    <th>Water (m3)</th>
                    <th>Exposure Hrs (Contractors)</th>
                    <th>Exposure Hrs (Staff)</th>
                    <th>Km (Light Vehicles)</th>
                    <th>Km (Heavy Vehicles)</th>
                    <th>GHG Emissions (t)</th>
                    <th>File Type</th>
                    <th>Actions</th>
                </tr>
            </thead>
            <tbody>

                <% records.forEach(record => { %>

                    <tr>
                        <td><%= record.hsseq_id %></td>
                        <td><%= record.record_month %></td>
                        <td><%= record.record_year %></td>
                        <td><%= record.hazardous_waste_tonnes %></td>
                        <td><%= record.non_hazardous_waste_tonnes %></td>
                        <td><%= record.water_consumption_m3 %></td>
                        <td><%= record.exposure_hours_contractors %></td>
                        <td><%= record.exposure_hours_staff %></td>
                        <td><%= record.kms_light_vehicles %></td>
                        <td><%= record.kms_heavy_goods_vehicles %></td>
                        <td><%= record.ghg_emissions_tonnes %></td>
                        <td><%= record.file_type || "-" %></td>
                        <td class="actions">

                            <a href="/hsseq/view/<%= record.hsseq_id %>" class="btn btn-view">View</a>
                            <a href="/hsseq/edit/<%= record.hsseq_id %>" class="btn btn-edit">Edit</a>

                            <form
                                class="inline"
                                action="/hsseq/delete/<%= record.hsseq_id %>"
                                method="POST"
                                onsubmit="return confirm('Delete this record?');">
                                <button type="submit" class="btn btn-delete">Delete</button>
                            </form>

                        </td>
                    </tr>

                <% }); %>

            </tbody>
        </table>
        </div>

    <% } %>

</div>

</body>
</html>
