<!DOCTYPE html>
<html lang="en" class="pg-employees-view">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= title %></title>

    <link rel="stylesheet" href="/main.css">
</head>

<body>

<%- include('../partials/topnav') %>


<div class="container">

    <h1>Employee Details</h1>

    <div class="field">
        <label>Employee ID</label>
        <div><%= employee.employee_id %></div>
    </div>

    <div class="field">
        <label>Employee Name</label>
        <div><%= employee.employee_name %></div>
    </div>

    <div class="field">
        <label>Gender</label>
        <div><%= employee.gender || "-" %></div>
    </div>

    <div class="field">
        <label>Phone</label>
        <div><%= employee.phone || "-" %></div>
    </div>

    <div class="field">
        <label>Email</label>
        <div><%= employee.email || "-" %></div>
    </div>

    <div class="field">
        <label>Job Title</label>
        <div><%= employee.job_title || "-" %></div>
    </div>

    <div class="field">
        <label>Department</label>
        <div><%= employee.department_name || "-" %></div>
    </div>

    <div class="field">
        <label>Employment Date</label>
        <div>
            <%= employee.employment_date
                ? employee.employment_date.toISOString().split('T')[0]
                : "-" %>
        </div>
    </div>

    <div class="field">
        <label>Status</label>
        <div>
            <span class="badge <%= employee.status === 'Active' ? 'badge-active' : 'badge-inactive' %>">
                <%= employee.status || "N/A" %>
            </span>
        </div>
    </div>

    <div class="field">
        <label>Role ID</label>
        <div><%= employee.role_id || "-" %></div>
    </div>

    <div class="buttons">
        <% if (can.edit) { %>
<a href="/employees/edit/<%= employee.employee_id %>" class="btn btn-edit">Edit</a>
<% } %>
        <a href="/employees" class="btn btn-back">Back to List</a>
    </div>

</div>

<%- include('../partials/footer') %>

</body>
</html>
