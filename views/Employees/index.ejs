<!DOCTYPE html>
<html lang="en" class="pg-employees-index">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= title %></title>

    <link rel="stylesheet" href="/main.css">
</head>

<body>

<%- include('../partials/topnav') %>


<div class="container">

    <div class="top-bar">
        <h1>Employees</h1>
        <% if (can.add) { %>
<a href="/employees/add" class="btn btn-add">+ Add Employee</a>
<% } %>
    </div>

    <%- include('../partials/toolbar') %>



    <% if (employees.length === 0) { %>

        <div class="empty">No employees found.</div>

    <% } else { %>

        <table>
            <thead>
                <tr>
                    <th>ID</th>
                    <th>Name</th>
                    <th>Job Title</th>
                    <th>Department</th>
                    <th>Phone</th>
                    <th>Email</th>
                    <th>Status</th>
                    <th>Actions</th>
                </tr>
            </thead>
            <tbody>

                <% employees.forEach(employee => { %>

                    <tr>
                        <td><%= employee.employee_id %></td>
                        <td><%= employee.employee_name %></td>
                        <td><%= employee.job_title || "-" %></td>
                        <td><%= employee.department_name || "-" %></td>
                        <td><%= employee.phone || "-" %></td>
                        <td><%= employee.email || "-" %></td>
                        <td>
                            <span class="badge <%= employee.status === 'Active' ? 'badge-active' : 'badge-inactive' %>">
                                <%= employee.status || "N/A" %>
                            </span>
                        </td>
                        <td class="actions">

                            <a href="/employees/view/<%= employee.employee_id %>" class="btn btn-view">View</a>
                            <% if (can.edit) { %>
<a href="/employees/edit/<%= employee.employee_id %>" class="btn btn-edit">Edit</a>
<% } %>

                            <% if (can.delete) { %>
<form
                                class="inline"
                                action="/employees/delete/<%= employee.employee_id %>"
                                method="POST"
                                onsubmit="return confirm('Delete this employee?');">
                                <button type="submit" class="btn btn-delete">Delete</button>
                            </form>
<% } %>

                        </td>
                    </tr>

                <% }); %>

            </tbody>
        </table>

    <% } %>

</div>

<%- include('../partials/footer') %>

</body>
</html>
